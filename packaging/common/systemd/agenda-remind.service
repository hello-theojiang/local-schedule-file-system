# Service utilisateur : notifications de bureau (notify-send) pour les rappels.
# Activation : systemctl --user enable --now agenda-remind
# Dossier : ~/.config/agenda/config (ligne dir=...) ou variable AGENDA_DIR.
[Unit]
Description=Rappels de l'agenda (notifications de bureau)
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/agenda remind
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
